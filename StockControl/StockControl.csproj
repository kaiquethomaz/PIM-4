<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StockControl</RootNamespace>
    <!-- Gera o XML com os comentários /// para o Swagger mostrar a documentação dos endpoints -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 = aviso de "falta comentário ///" em classes públicas; não exigimos em todas -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hash de senha (mesma biblioteca usada no PIM III) -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <!-- Entity Framework Core para SQL Server (sem migrations: o banco vem do script SQL) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <!-- Autenticação da API do mobile por token JWT -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <!-- Swagger: documentação e teste dos endpoints da API -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
