@model List<Usuario>
@using StockControl.Extensions
@{
    ViewData["Title"] = "Usuários";
    var usuarioLogadoId = (int)ViewBag.UsuarioLogadoId;
}

<div class="barra-titulo">
    <div>
        <h1>Usuários</h1>
        <p class="subtitulo">Equipe do estabelecimento: quem pode entrar no sistema e o que cada um pode fazer.</p>
    </div>
    <div class="acoes">
        <a class="botao" asp-action="Criar">@Icones.Svg("mais") Novo usuário</a>
    </div>
</div>

<div class="cartao">
    <div class="tabela-container">
        <table>
            <caption>@Model.Count usuário(s)</caption>
            <thead>
                <tr>
                    <th scope="col">Usuário</th>
                    <th scope="col">Perfil</th>
                    <th scope="col">Situação</th>
                    <th scope="col">Cadastrado em</th>
                    <th scope="col"><span class="somente-leitor">Ações</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    var iniciais = string.Concat(u.Nome.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
                    <tr>
                        <td>
                            <span style="display: flex; align-items: center; gap: 12px">
                                <span class="avatar" aria-hidden="true">@iniciais</span>
                                <span class="celula-principal">
                                    <strong>
                                        @u.Nome
                                        @if (u.Id == usuarioLogadoId)
                                        {
                                            <span class="dica" style="font-weight: normal">(você)</span>
                                        }
                                    </strong>
                                    <span>@u.Email</span>
                                </span>
                            </span>
                        </td>
                        <td>@u.Perfil</td>
                        <td>
                            @if (u.Ativo)
                            {
                                <span class="etiqueta etiqueta-ok">Ativo</span>
                            }
                            else
                            {
                                <span class="etiqueta etiqueta-inativo">Inativo</span>
                            }
                        </td>
                        <td>@u.CriadoEm.ToString("dd/MM/yyyy")</td>
                        <td>
                            <div class="acoes">
                                <a class="botao botao-texto botao-pequeno" asp-action="Editar" asp-route-id="@u.Id"
                                   aria-label="Editar @u.Nome">@Icones.Svg("editar") Editar</a>
                                @if (u.Id != usuarioLogadoId && u.Ativo)
                                {
                                    <a class="botao botao-texto perigo botao-pequeno" asp-action="Excluir" asp-route-id="@u.Id"
                                       data-confirmar-titulo="Excluir usuário?"
                                       data-confirmar="O usuário “@u.Nome” será excluído. Se ele já registrou entradas ou vendas, será apenas desativado (não consegue mais entrar)."
                                       aria-label="Excluir @u.Nome">@Icones.Svg("excluir") Excluir</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
