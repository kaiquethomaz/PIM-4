@model StockControl.ViewModels.ProdutoListaViewModel
@using StockControl.Extensions
@{
    ViewData["Title"] = "Produtos";
}

<div class="barra-titulo">
    <div>
        <h1>Produtos</h1>
        <p class="subtitulo">Catálogo do estabelecimento: preços, estoque e situação de cada produto.</p>
    </div>
    @if (Model.PodeGerenciar)
    {
        <div class="acoes">
            <a class="botao" asp-action="Criar">@Icones.Svg("mais") Novo produto</a>
        </div>
    }
</div>

<div class="cartao">
    @* Busca: formulário GET (os filtros ficam na URL e dá para favoritar) *@
    <form method="get" asp-action="Index" class="busca" role="search">
        <div class="campo">
            <label for="busca">Buscar por nome ou código de barras</label>
            <input type="search" id="busca" name="busca" value="@Model.Busca" placeholder="Ex.: arroz ou 7891000000011" />
        </div>
        @if (Model.PodeGerenciar)
        {
            <div class="campo-checkbox">
                <input type="checkbox" id="mostrarInativos" name="mostrarInativos" value="true" checked="@Model.MostrarInativos" />
                <label for="mostrarInativos">Mostrar inativos</label>
            </div>
        }
        <button type="submit" class="botao botao-secundario">@Icones.Svg("busca") Buscar</button>
        @if (!string.IsNullOrEmpty(Model.Busca) || Model.MostrarInativos)
        {
            <a class="botao botao-texto" asp-action="Index">Limpar</a>
        }
    </form>

    @if (Model.Produtos.Count == 0)
    {
        <div class="vazio" role="status">
            @Icones.Svg("produtos")
            <p>Nenhum produto encontrado.</p>
        </div>
    }
    else
    {
        <div class="tabela-container">
            <table>
                <caption role="status">@Model.Produtos.Count produto(s) encontrado(s)</caption>
                <thead>
                    <tr>
                        <th scope="col">Produto</th>
                        <th scope="col">Código de barras</th>
                        <th scope="col" class="numero">Preço</th>
                        <th scope="col" class="numero">Estoque</th>
                        <th scope="col">Situação</th>
                        @if (Model.PodeGerenciar)
                        {
                            <th scope="col"><span class="somente-leitor">Ações</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Produtos)
                    {
                        <tr>
                            <td>
                                <span class="celula-principal">
                                    <strong>@p.Nome</strong>
                                    <span>@p.Categoria?.Nome</span>
                                </span>
                            </td>
                            <td><span class="dica">@p.CodigoBarras</span></td>
                            <td class="numero">@p.Preco.ToString("C")</td>
                            <td class="numero"><strong>@p.EstoqueAtual</strong> <span class="dica">/ mín. @p.EstoqueMinimo</span></td>
                            <td>
                                @* Texto + cor: a informação não depende só da cor (acessibilidade) *@
                                @if (!p.Ativo)
                                {
                                    <span class="etiqueta etiqueta-inativo">Inativo</span>
                                }
                                else if (p.EstaAbaixoDoMinimo())
                                {
                                    <span class="etiqueta etiqueta-alerta">Abaixo do mínimo</span>
                                }
                                else
                                {
                                    <span class="etiqueta etiqueta-ok">OK</span>
                                }
                            </td>
                            @if (Model.PodeGerenciar)
                            {
                                <td>
                                    <div class="acoes">
                                        <a class="botao botao-texto botao-pequeno" asp-action="Editar" asp-route-id="@p.Id"
                                           aria-label="Editar @p.Nome">@Icones.Svg("editar") Editar</a>
                                        @if (p.Ativo)
                                        {
                                            <a class="botao botao-texto perigo botao-pequeno" asp-action="Excluir" asp-route-id="@p.Id"
                                               data-confirmar-titulo="Excluir produto?"
                                               data-confirmar="O produto “@p.Nome” será excluído. Se ele já teve entradas ou vendas, será apenas desativado, para não perder o histórico."
                                               aria-label="Excluir @p.Nome">@Icones.Svg("excluir") Excluir</a>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
