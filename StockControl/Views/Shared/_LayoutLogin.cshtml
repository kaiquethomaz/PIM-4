<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - StockControl</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <meta name="theme-color" content="#0b1f4d" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/conta.css" asp-append-version="true" />
</head>
<body class="pagina-login">
    @* Layout sem menu, usado no Login e no Cadastro de estabelecimento:
       painel da marca à esquerda + formulário à direita. *@
    <div class="login-tela">
        <partial name="_PainelMarca" />

        <main class="login-formulario">
            <div class="login-caixa @ViewData["ClasseCaixa"]">
                <div class="login-logo-celular">
                    <partial name="_Logo" />
                </div>

                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/js/conta.js" asp-append-version="true"></script>
    <script src="~/js/formularios.js" asp-append-version="true"></script>
</body>
</html>
