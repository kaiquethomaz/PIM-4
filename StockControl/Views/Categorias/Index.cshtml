@model List<Categoria>
@{
    ViewData["Title"] = "Categorias";
}

<div class="barra-titulo">
    <h1>Categorias</h1>
    <a class="botao" asp-action="Criar">+ Nova categoria</a>
</div>

<div class="cartao">
    @if (Model.Count == 0)
    {
        <p>Nenhuma categoria cadastrada.</p>
    }
    else
    {
        <div class="tabela-container">
            <table>
                <caption>@Model.Count categoria(s)</caption>
                <thead>
                    <tr>
                        <th scope="col">Nome</th>
                        <th scope="col">Descrição</th>
                        <th scope="col"><span class="somente-leitor">Ações</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.Nome</td>
                            <td>@c.Descricao</td>
                            <td>
                                <div class="acoes">
                                    @* aria-label diz ao leitor de tela QUAL item será editado *@
                                    <a class="botao botao-secundario botao-pequeno" asp-action="Editar" asp-route-id="@c.Id"
                                       aria-label="Editar @c.Nome">Editar</a>
                                    <a class="botao botao-perigo botao-pequeno" asp-action="Excluir" asp-route-id="@c.Id"
                                       aria-label="Excluir @c.Nome">Excluir</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
