@model List<Fornecedor>
@using StockControl.Extensions
@{
    ViewData["Title"] = "Fornecedores";
}

<div class="barra-titulo">
    <div>
        <h1>Fornecedores</h1>
        <p class="subtitulo">Empresas de quem o estabelecimento compra os produtos.</p>
    </div>
    <div class="acoes">
        <a class="botao" asp-action="Criar">@Icones.Svg("mais") Novo fornecedor</a>
    </div>
</div>

<div class="cartao">
    @if (Model.Count == 0)
    {
        <div class="vazio">
            @Icones.Svg("fornecedores")
            <p>Nenhum fornecedor cadastrado.</p>
        </div>
    }
    else
    {
        <div class="tabela-container">
            <table>
                <caption>@Model.Count fornecedor(es)</caption>
                <thead>
                    <tr>
                        <th scope="col">Fornecedor</th>
                        <th scope="col">CNPJ</th>
                        <th scope="col">Contato</th>
                        <th scope="col"><span class="somente-leitor">Ações</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model)
                    {
                        <tr>
                            <td><strong>@f.RazaoSocial</strong></td>
                            <td style="white-space: nowrap">@f.CnpjFormatado()</td>
                            <td>
                                <span class="celula-principal">
                                    <span style="color: var(--texto)">@f.Telefone</span>
                                    <span>@f.Email</span>
                                </span>
                            </td>
                            <td>
                                <div class="acoes">
                                    <a class="botao botao-texto botao-pequeno" asp-action="Editar" asp-route-id="@f.Id"
                                       aria-label="Editar @f.RazaoSocial">@Icones.Svg("editar") Editar</a>
                                    <a class="botao botao-texto perigo botao-pequeno" asp-action="Excluir" asp-route-id="@f.Id"
                                       data-confirmar-titulo="Excluir fornecedor?"
                                       data-confirmar="O fornecedor “@f.RazaoSocial” será excluído. Essa ação não pode ser desfeita. Fornecedores com produtos não podem ser excluídos."
                                       aria-label="Excluir @f.RazaoSocial">@Icones.Svg("excluir") Excluir</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
