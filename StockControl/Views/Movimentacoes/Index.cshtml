@model StockControl.ViewModels.MovimentacaoListaViewModel
@using StockControl.Extensions
@{
    ViewData["Title"] = "Movimentações";
}

<div class="barra-titulo">
    <div>
        <h1>Movimentações</h1>
        <p class="subtitulo">Entradas de mercadoria e vendas do estabelecimento, por período.</p>
    </div>
    <div class="acoes">
        <a class="botao" asp-action="Registrar" asp-route-tipo="@TipoMovimentacao.Saida">@Icones.Svg("mais") Registrar venda</a>
        <a class="botao botao-secundario" asp-action="Registrar" asp-route-tipo="@TipoMovimentacao.Entrada">@Icones.Svg("entrada") Registrar entrada</a>
    </div>
</div>

@if (Model.Erro is null)
{
    <div class="kpis kpis-3">
        <div class="cartao kpi">
            <span class="kpi-icone kpi-azul">@Icones.Svg("movimentacoes")</span>
            <span class="kpi-texto">
                <span class="kpi-rotulo">Movimentações</span>
                <span class="kpi-valor">@Model.Itens.Count</span>
                <span class="kpi-detalhe">no período</span>
            </span>
        </div>
        <div class="cartao kpi">
            <span class="kpi-icone kpi-verde">@Icones.Svg("entrada")</span>
            <span class="kpi-texto">
                <span class="kpi-rotulo">Unidades de entrada</span>
                <span class="kpi-valor">@Model.TotalEntradas</span>
                <span class="kpi-detalhe">compras e reposições</span>
            </span>
        </div>
        <div class="cartao kpi">
            <span class="kpi-icone kpi-roxo">@Icones.Svg("carrinho")</span>
            <span class="kpi-texto">
                <span class="kpi-rotulo">Unidades vendidas</span>
                <span class="kpi-valor">@Model.TotalSaidas</span>
                <span class="kpi-detalhe">vendas no período</span>
            </span>
        </div>
    </div>
}

<div class="cartao">
    @* Filtro por período: formulário GET, as datas ficam na URL *@
    <form method="get" asp-action="Index" class="busca" aria-label="Filtrar por período">
        <div class="campo">
            <label for="dataInicio">Data inicial</label>
            <input type="date" id="dataInicio" name="dataInicio" value="@Model.DataInicio.ToString("yyyy-MM-dd")" />
        </div>
        <div class="campo">
            <label for="dataFim">Data final</label>
            <input type="date" id="dataFim" name="dataFim" value="@Model.DataFim.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="botao botao-secundario">@Icones.Svg("filtro") Filtrar</button>
    </form>

    @if (Model.Erro is not null)
    {
        <div class="alerta alerta-erro" role="alert">@Model.Erro</div>
    }
    else if (Model.Itens.Count == 0)
    {
        <div class="vazio" role="status">
            @Icones.Svg("movimentacoes")
            <p>Nenhuma movimentação entre @Model.DataInicio.ToString("dd/MM/yyyy") e @Model.DataFim.ToString("dd/MM/yyyy").</p>
        </div>
    }
    else
    {
        <div class="tabela-container">
            <table>
                <caption role="status">
                    De @Model.DataInicio.ToString("dd/MM/yyyy") a @Model.DataFim.ToString("dd/MM/yyyy"): @Model.Itens.Count movimentação(ões)
                </caption>
                <thead>
                    <tr>
                        <th scope="col">Data</th>
                        <th scope="col">Tipo</th>
                        <th scope="col">Produto</th>
                        <th scope="col" class="numero">Qtd.</th>
                        <th scope="col">Registrado por</th>
                        <th scope="col">Observação</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Itens)
                    {
                        <tr>
                            <td style="white-space: nowrap">@m.Data.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (m.Tipo == "ENTRADA")
                                {
                                    <span class="etiqueta etiqueta-entrada">Entrada</span>
                                }
                                else
                                {
                                    <span class="etiqueta etiqueta-saida">Venda</span>
                                }
                            </td>
                            <td><strong>@m.Produto</strong></td>
                            <td class="numero">@m.Quantidade</td>
                            <td>@m.Usuario</td>
                            <td><span class="dica">@m.Observacao</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
